# Lokale database (SQLite bestand) — voor productie op Vercel: Postgres connectionstring van Neon/Supabase
DATABASE_URL="file:./dev.db"

# Lange, willekeurige geheime string om sessie-cookies te ondertekenen.
# Genereer er een met: openssl rand -base64 32
AUTH_SECRET="verander-dit-naar-een-lange-willekeurige-string"

# Startwaarden voor het admin-account (gebruikt door prisma/seed.mjs)
ADMIN_EMAIL="admin@repairflow.be"
ADMIN_PASSWORD="wijzig-dit-wachtwoord"
