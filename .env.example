# Lokale database (SQLite bestand) — voor productie op Vercel: Postgres connectionstring van Neon/Supabase
DATABASE_URL="file:./dev.db"

# Lange, willekeurige geheime string om sessie-cookies te ondertekenen.
# Genereer er een met: openssl rand -base64 32
AUTH_SECRET="verander-dit-naar-een-lange-willekeurige-string"

# Startwaarden voor het admin-account (gebruikt door prisma/seed.mjs)
ADMIN_EMAIL="admin@repairflow.be"
ADMIN_PASSWORD="wijzig-dit-wachtwoord"

# --- Bevestigingsmail (optioneel) ---
# Zonder deze twee wordt er geen mail verstuurd wanneer een afspraak
# bevestigd wordt (er komt dan alleen een waarschuwing in de serverlogs).
# Account aanmaken op https://resend.com, domein verifiëren, API key hier zetten.
RESEND_API_KEY=""
EMAIL_FROM="RepairFlow <noreply@jouwdomein.be>"

# --- Bevestigings-sms (optioneel) ---
# Zonder deze drie wordt er geen sms verstuurd. Account op https://twilio.com,
# een verzendnummer aanschaffen en hieronder invullen.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
