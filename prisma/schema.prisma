// Prisma schema voor RepairFlow
// LOKAAL: SQLite (bestand, geen setup nodig)
// PRODUCTIE (Vercel): verander provider naar "postgresql" en DATABASE_URL naar je Neon/Supabase connectionstring

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Category {
  id       String    @id @default(cuid())
  name     String    // bv. "iPhone", "Samsung", "MacBook"
  active   Boolean   @default(true)
  slug     String    @unique
  order    Int       @default(0)
  imageUrl String?
  icon     String?
  services Service[]
  models   Model[]
  sections ModelSection[]
}

model Model {
  id          String        @id @default(cuid())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  sectionId   String?
  section     ModelSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  name        String        // bv. "iPhone 13"
  slug        String        // bv. "iphone-13"
  order       Int           @default(0)
  active      Boolean       @default(true)
  imageUrl    String?
  services    Service[]
  appointments Appointment[]

  @@unique([categoryId, slug])
}

model ModelSection {
  id         String    @id @default(cuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  order      Int       @default(0)
  models     Model[]

  @@unique([categoryId, name])
  @@index([categoryId, order])
}

model Service {
  id          String        @id @default(cuid())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  modelId     String?
  model       Model?        @relation(fields: [modelId], references: [id], onDelete: SetNull)
  name        String        // bv. "Scherm vervangen"
  priceCents  Int           // prijs in centen, voorkomt afrondingsfouten
  durationMin Int           @default(60)
  durationUnit String       @default("min") // "min" of "uur"
  active      Boolean       @default(true)
  featured    Boolean       @default(false) // toont bij "Populaire reparaties" op homepage
  featuredOrder Int         @default(0)
    appointments Appointment[] // Removed abandoned model-toggle field
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
}

// Losse producten die je aan de balie verkoopt (screenprotectors, hoesjes,
// kabels, ...) — los van de reparatiediensten hierboven.
model Product {
  id         String      @id @default(cuid())
  name       String      // bv. "Screenprotector iPhone 13"
  category   String      @default("Overig") // vrij label, bv. "Hoesjes", "Screenprotectors", "Kabels"
  sku        String?
  priceCents Int
  stock      Int         @default(0)
  active     Boolean     @default(true)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// Eén kassaverkoop (bon). Los van Appointment: dit zijn balieverkopen
// (reparatie meteen uitgevoerd/afgerekend en/of losse producten), niet
// online geboekte afspraken.
model Order {
  id             String      @id @default(cuid())
  orderNumber    Int         @unique @default(autoincrement()) // korte, oplopende bonnummers voor op het ticket
  paymentMethod  String      // "cash" | "online"
  status         String      @default("completed") // completed | cancelled
  customerName   String?
  totalCents     Int
  cashierEmail   String?     // snapshot van de ingelogde medewerker op moment van verkoop
  notes          String?
  items          OrderItem[]
  createdAt      DateTime    @default(now())
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           String   // "repair" | "product"
  name           String   // snapshot omschrijving, bv. "PlayStation 5 — Scherm vervangen"
  unitPriceCents Int      // snapshot prijs per stuk op moment van verkoop
  quantity       Int      @default(1)
  lineTotalCents Int
  serviceId      String?
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Appointment {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  modelId       String?
  model         Model?   @relation(fields: [modelId], references: [id], onDelete: SetNull)
  customerName  String
  email         String
  phone         String
  date          String   // YYYY-MM-DD
  timeSlot      String   // "09:00"
  status        String   @default("pending") // pending | confirmed | done | cancelled
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BusinessHours {
  id        String   @id @default("default")
  hours     Json
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("staff") // "owner" (alles) | "staff" (beperkt door permissions)
  permissions  Json     @default("{}")    // bv. { "appointments": true, "pricing": false, ... } — genegeerd voor "owner"
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id                 String    @id @default("default")
  maintenanceMode    Boolean   @default(false)
  maintenanceUntil   DateTime?
  maintenanceMessage String?
  updatedAt          DateTime  @updatedAt
}
